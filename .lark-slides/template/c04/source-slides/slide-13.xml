      <shape width="491.0072440944882" height="310.2" topLeftX="78.31724409448816" topLeftY="122.04023622047245" type="text" id="bQz">
        <border color="rgba(0, 0, 0, 1)" lineJoin="miter" miterLimit="10"/>
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">标识符用于命名变量、函数等。</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><br/><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">命名规则：</span></p>
          <ol listStyle="arabic-period">
            <li>
              <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">只能使用 </span><strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" italic="false" strikethrough="false" underline="false">字母、数字、下划线</span></strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">；</span></p>
            </li>
            <li>
              <p textAlign="left" lineSpacing="multiple:1.2"><strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" italic="false" strikethrough="false" underline="false">不能以数字开头</span></strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">；</span></p>
            </li>
            <li>
              <p textAlign="left" lineSpacing="multiple:1.2"><strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" italic="false" strikethrough="false" underline="false">区分大小写</span></strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">；</span></p>
            </li>
            <li>
              <p textAlign="left" lineSpacing="multiple:1.2" beforeLineSpacing="fixed:12.00"><strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" italic="false" strikethrough="false" underline="false">不能使用关键字</span></strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">。</span></p>
            </li>
          </ol>
          <p textAlign="left" lineSpacing="multiple:1.2"/>
          <p textAlign="left" lineSpacing="multiple:1.2" afterLineSpacing="fixed:5.00"><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">✅ 合法示例：</span><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="Courier New" bold="false" italic="false" strikethrough="false" underline="false">score</span><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">, </span><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="Courier New" bold="false" italic="false" strikethrough="false" underline="false">user_name</span><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">, </span><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="Courier New" bold="false" italic="false" strikethrough="false" underline="false">_count</span><br/><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">❌ 非法示例：</span><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="Courier New" bold="false" italic="false" strikethrough="false" underline="false">2num</span><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">, </span><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="Courier New" bold="false" italic="false" strikethrough="false" underline="false">int</span><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">, </span><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="Courier New" bold="false" italic="false" strikethrough="false" underline="false">user-name</span></p>
        </content>
