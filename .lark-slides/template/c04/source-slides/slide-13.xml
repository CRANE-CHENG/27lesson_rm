          <p textAlign="left" lineSpacing="multiple:1.4"><span color="rgba(201, 209, 217, 1)" fontSize="20" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">a</span><span color="rgba(187, 190, 191, 1)" fontSize="20" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false"> </span><span color="rgba(212, 212, 212, 1)" fontSize="20" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">=</span><span color="rgba(187, 190, 191, 1)" fontSize="20" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false"> b;</span></p>
