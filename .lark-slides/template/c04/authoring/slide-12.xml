      <shape width="66.94629921259842" height="50.8" topLeftX="33.25511811023622" topLeftY="15.769133858267715" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><em><span color="rgba(255, 255, 255, 1)" fontSize="36" fontFamily="锐字真言体免费商用" strikethrough="false" underline="false">03</span></em></strong></p>
        </content>
      </shape>
      <shape width="560" height="36.25" topLeftX="110.86724409448817" topLeftY="33.10251968503937" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><em><span color="rgba(3, 72, 149, 1)" fontSize="24" fontFamily="思源黑体" strikethrough="false" underline="false">PWM 是什么：引脚一直在开关？</span></em></strong></p>
        </content>
      </shape>
      <shape width="430" height="66" topLeftX="62.42" topLeftY="124" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><span color="rgba(3, 72, 149, 1)" fontSize="17" fontFamily="思源黑体" strikethrough="false" underline="false">① 方波：开关周期</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">引脚在高、低电平之间反复跳，一个「高 + 低」就是一个周期。开得够快，人眼就看不到闪。</span></p>
        </content>
      </shape>
      <shape width="430" height="66" topLeftX="62.42" topLeftY="194" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><span color="rgba(3, 72, 149, 1)" fontSize="17" fontFamily="思源黑体" strikethrough="false" underline="false">② 频率：一秒钟几次</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">调灯要几百赫兹以上，不然看得出闪；舵机固定 50Hz。频率定整个周期的长短。</span></p>
        </content>
      </shape>
      <shape width="430" height="66" topLeftX="62.42" topLeftY="264" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><span color="rgba(3, 72, 149, 1)" fontSize="17" fontFamily="思源黑体" strikethrough="false" underline="false">③ 占空比：高电平占多少</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">高电平时间 ÷ 周期。占空比 50% 就是半亮，10% 很暗，90% 接近全亮。</span></p>
        </content>
      </shape>
      <shape width="378" height="230" topLeftX="510" topLeftY="112" type="rect">
        <fill>
          <fillColor color="rgba(240, 240, 240, 1)"/>
        </fill>
        <border color="rgba(3, 72, 149, 1)" width="1" lineJoin="miter" miterLimit="10"/>
      </shape>
      <shape width="354" height="212" topLeftX="522" topLeftY="120" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="no-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(86, 86, 86, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">// 周期 1ms（频率 1kHz）</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(86, 86, 86, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">// 高 0.5ms + 低 0.5ms</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">//   占空比 50% → 半亮</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(86, 86, 86, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">// 高 0.1ms + 低 0.9ms</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">//   占空比 10% → 很暗</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(86, 86, 86, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">// 引脚变了吗？没变</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(86, 86, 86, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">// 变的只是「开多久」</span></p>
        </content>
      </shape>
      <shape width="817.58" height="34" topLeftX="62.42" topLeftY="372" type="rect">
        <fill>
          <fillColor color="rgba(3, 72, 149, 1)"/>
        </fill>
        <content verticalAlign="middle" paddingTop="3.6" paddingBottom="3.6" paddingLeft="14" paddingRight="14" fontSize="16" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(255, 255, 255, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">PWM 把「开和关」换成了「开多久、关多久」：频率决定闪不闪，占空比决定亮多少。</span></p>
        </content>
      </shape>
