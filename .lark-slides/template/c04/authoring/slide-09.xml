      <shape width="354" height="212" topLeftX="522" topLeftY="120" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="no-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">uint32_t last = 0;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">while (1) {</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  if (HAL_GetTick() - last &gt;= 1000) {</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">    last = HAL_GetTick();</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(140, 70, 190, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">    HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  }</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(86, 86, 86, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  // 这里还能干别的</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">}</span></p>
        </content>
      </shape>
      <shape width="817.58" height="34" topLeftX="62.42" topLeftY="372" type="rect">
