      <shape width="560" height="36.25" topLeftX="110.86724409448817" topLeftY="33.10251968503937" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><em><span color="rgba(3, 72, 149, 1)" fontSize="24" fontFamily="思源黑体" strikethrough="false" underline="false">建工程：五步怎么走完？</span></em></strong></p>
        </content>
      </shape>
      <shape width="430" height="66" topLeftX="62.42" topLeftY="124" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><span color="rgba(3, 72, 149, 1)" fontSize="17" fontFamily="思源黑体" strikethrough="false" underline="false">① 选芯片、定时钟</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">选 STM32F103C8T6，外部晶振 8MHz 倍频到 72MHz——时钟不对，串口和定时器全是错的。</span></p>
        </content>
      </shape>
      <shape width="430" height="66" topLeftX="62.42" topLeftY="194" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><span color="rgba(3, 72, 149, 1)" fontSize="17" fontFamily="思源黑体" strikethrough="false" underline="false">② 配引脚、命名</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">PC13 点成 GPIO_Output，模式选推挽输出、无上下拉；引脚改名 LED 以后好找。</span></p>
        </content>
      </shape>
      <shape width="430" height="66" topLeftX="62.42" topLeftY="264" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><span color="rgba(3, 72, 149, 1)" fontSize="17" fontFamily="思源黑体" strikethrough="false" underline="false">③ 生成、只改 USER CODE</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">Toolchain 选 MDK-ARM；自己写的代码放在 USER CODE BEGIN 与 END 之间，重新生成不会被冲掉。</span></p>
        </content>
      </shape>
      <shape width="378" height="230" topLeftX="510" topLeftY="112" type="rect">
        <fill>
          <fillColor color="rgba(240, 240, 240, 1)"/>
        </fill>
        <border color="rgba(3, 72, 149, 1)" width="1" lineJoin="miter" miterLimit="10"/>
      </shape>
      <shape width="354" height="212" topLeftX="522" topLeftY="120" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="no-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">void MX_GPIO_Init(void) {</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  GPIO_InitTypeDef g = {0};</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  g.Pin   = GPIO_PIN_13;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  g.Mode  = GPIO_MODE_OUTPUT_PP;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  g.Pull  = GPIO_NOPULL;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  g.Speed = GPIO_SPEED_FREQ_HIGH;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(140, 70, 190, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  HAL_GPIO_Init(GPIOC, &amp;g);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">}</span></p>
        </content>
      </shape>
      <shape width="817.58" height="34" topLeftX="62.42" topLeftY="372" type="rect">
        <fill>
          <fillColor color="rgba(3, 72, 149, 1)"/>
        </fill>
        <content verticalAlign="middle" paddingTop="3.6" paddingBottom="3.6" paddingLeft="14" paddingRight="14" fontSize="16" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(255, 255, 255, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">CubeMX 把寄存器配置翻译成 init 代码，你的工作只剩 while(1) 里那几行逻辑。</span></p>
        </content>
