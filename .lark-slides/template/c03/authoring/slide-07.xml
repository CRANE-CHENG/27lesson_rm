      <shape width="560" height="36.25" topLeftX="110.86724409448817" topLeftY="33.10251968503937" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><em><span color="rgba(3, 72, 149, 1)" fontSize="24" fontFamily="思源黑体" strikethrough="false" underline="false">点亮一颗 LED：三行代码够不够？</span></em></strong></p>
        </content>
      </shape>
      <shape width="430" height="66" topLeftX="62.42" topLeftY="124" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><span color="rgba(3, 72, 149, 1)" fontSize="17" fontFamily="思源黑体" strikethrough="false" underline="false">① WritePin 定电平</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">三个参数：哪个口、哪根脚、给高还是给低。PC13 是低电平点亮，写 RESET 才亮。</span></p>
        </content>
      </shape>
      <shape width="430" height="66" topLeftX="62.42" topLeftY="194" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><span color="rgba(3, 72, 149, 1)" fontSize="17" fontFamily="思源黑体" strikethrough="false" underline="false">② TogglePin 翻转</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">翻转不用记当前电平，配一次 Delay 就是闪烁；想快想慢，只改 Delay 的毫秒数。</span></p>
        </content>
      </shape>
      <shape width="430" height="66" topLeftX="62.42" topLeftY="264" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><span color="rgba(3, 72, 149, 1)" fontSize="17" fontFamily="思源黑体" strikethrough="false" underline="false">③ Delay 的代价</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">HAL_Delay 是空转等待，等待期间什么都干不了——灯闪了，按键就顾不上，这是真实问题。</span></p>
        </content>
      </shape>
      <shape width="378" height="230" topLeftX="510" topLeftY="112" type="rect">
        <fill>
          <fillColor color="rgba(240, 240, 240, 1)"/>
        </fill>
        <border color="rgba(3, 72, 149, 1)" width="1" lineJoin="miter" miterLimit="10"/>
