      <shape width="354" height="212" topLeftX="522" topLeftY="120" type="text">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="no-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">while (1) {</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(140, 70, 190, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13, GPIO_PIN_RESET);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  HAL_Delay(1000);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(140, 70, 190, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13, GPIO_PIN_SET);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">  HAL_Delay(1000);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(31, 35, 41, 1)" fontSize="15" fontFamily="Consolas" bold="false" strikethrough="false" underline="false">}</span></p>
        </content>
      </shape>
      <shape width="817.58" height="34" topLeftX="62.42" topLeftY="372" type="rect">
        <fill>
          <fillColor color="rgba(3, 72, 149, 1)"/>
        </fill>
        <content verticalAlign="middle" paddingTop="3.6" paddingBottom="3.6" paddingLeft="14" paddingRight="14" fontSize="16" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(255, 255, 255, 1)" fontSize="15" fontFamily="思源黑体" bold="false" strikethrough="false" underline="false">想一想：两个 HAL_Delay(1000) 都留着，灯是 1 秒闪一次；去掉第二个，灯会怎样？作业里有这道题。</span></p>
        </content>
