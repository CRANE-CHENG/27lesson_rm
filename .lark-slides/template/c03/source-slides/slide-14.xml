        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.4"><span color="rgba(197, 134, 192, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">#include</span><span color="rgba(86, 156, 214, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false"> </span><span color="rgba(165, 214, 255, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">&lt;stdio.h&gt;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.4"><span color="rgba(255, 123, 114, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">int</span><span color="rgba(187, 190, 191, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false"> </span><span color="rgba(210, 168, 255, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">main</span><span color="rgba(187, 190, 191, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">(</span><span color="rgba(255, 123, 114, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">void</span><span color="rgba(187, 190, 191, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">)</span></p>
          <p textAlign="left" lineSpacing="multiple:1.4"><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">{</span></p>
          <p textAlign="left" lineSpacing="multiple:1.4"><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">    </span><span color="rgba(255, 123, 114, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">int</span><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false"> a;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.4"><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">    </span><span color="rgba(210, 168, 255, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">printf</span><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">(</span><span color="rgba(165, 214, 255, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">"</span><span color="rgba(165, 214, 255, 1)" fontSize="14" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">请输入一个整数：</span><span color="rgba(165, 214, 255, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">"</span><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.4"><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">    </span><span color="rgba(210, 168, 255, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">scanf</span><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">(</span><span color="rgba(165, 214, 255, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">"</span><span color="rgba(255, 123, 114, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">%d</span><span color="rgba(165, 214, 255, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">"</span><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">, </span><span color="rgba(212, 212, 212, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">&amp;</span><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">a);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.4"><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">    </span><span color="rgba(210, 168, 255, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">printf</span><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">(</span><span color="rgba(165, 214, 255, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">"</span><span color="rgba(165, 214, 255, 1)" fontSize="14" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">您输入的是：</span><span color="rgba(255, 123, 114, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">%d</span><span color="rgba(215, 186, 125, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">\n</span><span color="rgba(165, 214, 255, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">"</span><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">, a);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.4"><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">    </span><span color="rgba(197, 134, 192, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">return</span><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false"> </span><span color="rgba(181, 206, 168, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">0</span><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.4"><span color="rgba(201, 209, 217, 1)" fontSize="14" fontFamily="Consolas" bold="false" italic="false" strikethrough="false" underline="false">}</span></p>
