          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(23, 33, 43, 1)" fontSize="18.75" fontFamily="DejaVu Sans Mono" bold="false" italic="false" strikethrough="false" underline="false">    printf("U(V), I(A):\n");</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(23, 33, 43, 1)" fontSize="18.75" fontFamily="DejaVu Sans Mono" bold="false" italic="false" strikethrough="false" underline="false">    scanf("%lf %lf", &amp;voltage, &amp;current);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(23, 33, 43, 1)" fontSize="18.75" fontFamily="DejaVu Sans Mono" bold="false" italic="false" strikethrough="false" underline="false">    power = voltage * current;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2"><span color="rgba(23, 33, 43, 1)" fontSize="18.75" fontFamily="DejaVu Sans Mono" bold="false" italic="false" strikethrough="false" underline="false">    printf("P = %.2f W\n", power);</span></p>
