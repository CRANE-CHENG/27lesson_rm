      <shape width="649.3979527559055" height="341.70472440944883" topLeftX="100.20141732283463" topLeftY="99.778031496063" type="text" id="bKP">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2" afterLineSpacing="fixed:18.00"><strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" italic="false" strikethrough="false" underline="false">	编程语言</span></strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">是人向计算机描述任务和执行步骤的工具。</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2" afterLineSpacing="fixed:18.00"/>
          <p textAlign="left" lineSpacing="multiple:1.2" afterLineSpacing="fixed:18.00"><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">	</span><strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" italic="false" strikethrough="false" underline="false">机器语言</span></strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">是由0和1组成的指令，计算机可以直接执行。</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2" afterLineSpacing="fixed:18.00"><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">	C语言的程序通常经过</span><strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" italic="false" strikethrough="false" underline="false">编译、链接</span></strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">，生成包含机器代码的可执行程序。gcc常用于编译C程序，g++常用于编译C++程序。</span></p>
          <p textAlign="left" lineSpacing="multiple:1.2" afterLineSpacing="fixed:18.00"><strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" italic="false" strikethrough="false" underline="false">	C语言是面向过程的程序设计语言</span></strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">，强调按步骤解决问题。</span><strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" italic="false" strikethrough="false" underline="false"> </span></strong><span color="rgba(0, 0, 0, 1)" fontSize="24" fontFamily="思源黑体" bold="false" italic="false" strikethrough="false" underline="false">强调将问题拆成步骤，用代码逐步实现，通过函数组织和调用。</span></p>
