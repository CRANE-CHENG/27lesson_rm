      <shape width="793" height="104" topLeftX="74.42" topLeftY="276" type="text">
        <content verticalAlign="top" paddingTop="1" paddingBottom="0" paddingLeft="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas" bold="true">char</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> name[16] = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">"AIR"</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;   </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 3 个字符 + 结尾 '\0' */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">strlen</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(name)  </span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">-&gt; </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">3</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;      </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 数到 '\0' 为止 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">sizeof</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(name)  -&gt; </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">16</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;      </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 数组多大就多大 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas" bold="true">char</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> *p = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">"AIR"</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;          </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 指针指向常量区，不能改 p[0] */</span></p>
        </content>
