      <shape width="560" height="36.25" topLeftX="110.86724409448817" topLeftY="33.10251968503937" type="text" id="bUB">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><em><span color="rgba(3, 72, 149, 1)" fontSize="24" fontFamily="思源黑体" strikethrough="false" underline="false">一条直线写不出会判断、要重复的活</span></em></strong></p>
        </content>
      </shape>
      <shape width="430" height="60" topLeftX="62.42" topLeftY="124" type="text">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(3, 72, 149, 1)" fontSize="18" fontFamily="思源黑体" bold="true">问题：重复的代码只能靠手抄</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">要让一个 LED 闪十次，按顺序写就得抄十遍。</span></p>
        </content>
      </shape>
      <shape width="430" height="60" topLeftX="62.42" topLeftY="194" type="text">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(3, 72, 149, 1)" fontSize="18" fontFamily="思源黑体" bold="true">分支：条件不同，走不同的路</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">引脚读到低电平，才去消抖并把状态翻过来。</span></p>
        </content>
      </shape>
      <shape width="430" height="60" topLeftX="62.42" topLeftY="264" type="text">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(3, 72, 149, 1)" fontSize="18" fontFamily="思源黑体" bold="true">循环：同一段代码重复执行</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">重复到条件不成立为止，闪灯、扫描、遍历都靠它。</span></p>
        </content>
      </shape>
      <shape width="378" height="230" topLeftX="510" topLeftY="112" type="rect">
        <fill>
          <fillColor color="rgba(240, 240, 240, 1)"/>
        </fill>
        <border color="rgba(3, 72, 149, 1)" width="1" lineJoin="miter" miterLimit="10"/>
