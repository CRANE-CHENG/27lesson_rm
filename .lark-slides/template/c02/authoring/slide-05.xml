      <shape width="354" height="60" topLeftX="522" topLeftY="124" type="text">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="0" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 顺序：一条直线 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">a = 3; b = 4; c = a + b;</span></p>
        </content>
      </shape>
      <shape width="354" height="60" topLeftX="522" topLeftY="194" type="text">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="0" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 分支：满足条件才走 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas" bold="true">if</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> (a &gt; b) c = a;</span></p>
        </content>
      </shape>
      <shape width="354" height="60" topLeftX="522" topLeftY="264" type="text">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="0" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 循环：重复到条件不成立 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas" bold="true">for</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> (i = 0; i &lt; 3; i++) c = c + i;</span></p>
        </content>
      </shape>
      <shape width="817.58" height="32" topLeftX="62.42" topLeftY="372" type="rect">
        <fill>
          <fillColor color="rgba(3, 72, 149, 1)"/>
