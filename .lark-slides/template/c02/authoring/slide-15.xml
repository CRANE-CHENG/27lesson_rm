      <shape width="430" height="60" topLeftX="62.42" topLeftY="194" type="text">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(3, 72, 149, 1)" fontSize="18" fontFamily="思源黑体" bold="true">全局变量哪里都能碰</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">传状态很方便，但也哪里都能被改错，慎用。</span></p>
