      <shape width="354" height="224" topLeftX="522" topLeftY="120" type="text" id="bGL">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* switch：按值选一条路走 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">switch</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> (cmd) {</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">case</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">'A'</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">: LED_ON(); </span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">break</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">case</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">'B'</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">: LED_OFF(); </span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">break</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">default</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">: </span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">break</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">}</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35" />
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 忘了 break：会一路穿透 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">case</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">'A'</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">: LED_ON();</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">case</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">'B'</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">: LED_OFF(); </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 发 A 也关灯 */</span></p>
        </content>
      </shape>
      <shape width="817.58" height="32" topLeftX="62.42" topLeftY="372" presetHandlers="0" type="rect" id="bnU">
        <fill>
