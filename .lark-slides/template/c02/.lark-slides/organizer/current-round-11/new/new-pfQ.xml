      <shape width="20" height="20" topLeftX="62.42" topLeftY="128.0" presetHandlers="0" type="rect"><fill><fillColor color="rgba(3, 72, 149, 1)" /></fill><content paddingTop="0" paddingBottom="0" paddingLeft="0" paddingRight="0" fontSize="12" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" bold="true" lineSpacing="multiple:1.2" textAlign="center" verticalAlign="middle"><p textAlign="center"><span color="rgba(255, 255, 255, 1)" fontSize="12" fontFamily="思源黑体" bold="true">1.</span></p></content></shape><shape width="402" height="60" topLeftX="90.42" topLeftY="124" type="text" id="bGE">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">switch 只认整数和字符</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">case 后面必须是常量，不能写区间、不能比字符串。</span></p>
        </content>
      </shape>
      <shape width="20" height="20" topLeftX="62.42" topLeftY="198.0" presetHandlers="0" type="rect"><fill><fillColor color="rgba(3, 72, 149, 1)" /></fill><content paddingTop="0" paddingBottom="0" paddingLeft="0" paddingRight="0" fontSize="12" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" bold="true" lineSpacing="multiple:1.2" textAlign="center" verticalAlign="middle"><p textAlign="center"><span color="rgba(255, 255, 255, 1)" fontSize="12" fontFamily="思源黑体" bold="true">2.</span></p></content></shape><shape width="402" height="60" topLeftX="90.42" topLeftY="194" type="text" id="bnp">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">break 是每个分支的出口</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">忘了写就会穿透，接着执行下面那个 case。</span></p>
        </content>
      </shape>
      <shape width="20" height="20" topLeftX="62.42" topLeftY="268.0" presetHandlers="0" type="rect"><fill><fillColor color="rgba(3, 72, 149, 1)" /></fill><content paddingTop="0" paddingBottom="0" paddingLeft="0" paddingRight="0" fontSize="12" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" bold="true" lineSpacing="multiple:1.2" textAlign="center" verticalAlign="middle"><p textAlign="center"><span color="rgba(255, 255, 255, 1)" fontSize="12" fontFamily="思源黑体" bold="true">3.</span></p></content></shape><shape width="402" height="60" topLeftX="90.42" topLeftY="264" type="text" id="bnB">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">default 兜住没命中的情况</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">命令解析里，它就是「不认识这条命令」那一路。</span></p>
        </content>
      </shape>
      <shape width="378" height="240" topLeftX="510" topLeftY="112" presetHandlers="0" type="rect" id="bGc">
        <fill>
          <fillColor color="rgba(240, 240, 240, 1)" />
        </fill>
        <border color="rgba(3, 72, 149, 1)" width="1" lineJoin="miter" miterLimit="10" />
        <content fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" />
