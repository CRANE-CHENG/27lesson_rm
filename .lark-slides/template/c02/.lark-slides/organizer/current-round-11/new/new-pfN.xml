      <shape width="20" height="20" topLeftX="62.42" topLeftY="128.0" presetHandlers="0" type="rect"><fill><fillColor color="rgba(3, 72, 149, 1)" /></fill><content paddingTop="0" paddingBottom="0" paddingLeft="0" paddingRight="0" fontSize="12" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" bold="true" lineSpacing="multiple:1.2" textAlign="center" verticalAlign="middle"><p textAlign="center"><span color="rgba(255, 255, 255, 1)" fontSize="12" fontFamily="思源黑体" bold="true">1.</span></p></content></shape><shape width="402" height="60" topLeftX="90.42" topLeftY="124" type="text" id="bnS">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">三段式的分工</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">初始化只做一次；判断不成立就退出；更新在每轮之后。</span></p>
        </content>
      </shape>
      <shape width="20" height="20" topLeftX="62.42" topLeftY="198.0" presetHandlers="0" type="rect"><fill><fillColor color="rgba(3, 72, 149, 1)" /></fill><content paddingTop="0" paddingBottom="0" paddingLeft="0" paddingRight="0" fontSize="12" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" bold="true" lineSpacing="multiple:1.2" textAlign="center" verticalAlign="middle"><p textAlign="center"><span color="rgba(255, 255, 255, 1)" fontSize="12" fontFamily="思源黑体" bold="true">2.</span></p></content></shape><shape width="402" height="60" topLeftX="90.42" topLeftY="194" type="text" id="bnX">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">最适合「次数已知」</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">闪十次、取数组前 n 个，写成 for 一眼看出次数。</span></p>
        </content>
      </shape>
      <shape width="20" height="20" topLeftX="62.42" topLeftY="268.0" presetHandlers="0" type="rect"><fill><fillColor color="rgba(3, 72, 149, 1)" /></fill><content paddingTop="0" paddingBottom="0" paddingLeft="0" paddingRight="0" fontSize="12" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" bold="true" lineSpacing="multiple:1.2" textAlign="center" verticalAlign="middle"><p textAlign="center"><span color="rgba(255, 255, 255, 1)" fontSize="12" fontFamily="思源黑体" bold="true">3.</span></p></content></shape><shape width="402" height="60" topLeftX="90.42" topLeftY="264" type="text" id="bnd">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">循环变量只在循环里活</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">在 for 里定义 i，出了循环就不能再引用它。</span></p>
        </content>
      </shape>
      <shape width="378" height="240" topLeftX="510" topLeftY="112" presetHandlers="0" type="rect" id="bnM">
        <fill>
          <fillColor color="rgba(240, 240, 240, 1)" />
        </fill>
        <border color="rgba(3, 72, 149, 1)" width="1" lineJoin="miter" miterLimit="10" />
        <content fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" />
      </shape>
      <shape width="354" height="224" topLeftX="522" topLeftY="120" type="text" id="bnG">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 三段式：初始化 ; 判断 ; 更新 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">for</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> (</span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> i = 0; i &lt; 5; i++) {</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">LED_Toggle();</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">Delay(200);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">}</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35" />
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 实际执行顺序 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 初始化 → 判断 → 循环体 → 更新 → 回判断 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* i 取 0,1,2,3,4 时成立，循环体共 5 次 */</span></p>
        </content>
      </shape>
      <shape width="817.58" height="32" topLeftX="62.42" topLeftY="372" presetHandlers="0" type="rect" id="bnD">
        <fill>
          <fillColor color="rgba(3, 72, 149, 1)" />
        </fill>
        <content fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" />
