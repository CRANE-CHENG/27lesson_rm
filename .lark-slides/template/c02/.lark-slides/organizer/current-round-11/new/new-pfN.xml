        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="24" fontFamily="思源黑体" color="rgba(3, 72, 149, 1)" bold="true" italic="true" underline="false" strikethrough="false" lineSpacing="multiple:1.2" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><em><span color="rgba(3, 72, 149, 1)" fontSize="24" fontFamily="思源黑体" strikethrough="false" underline="false">for 把重复次数直接写在了条件里</span></em></strong></p>
