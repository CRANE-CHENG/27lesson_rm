      </content>
    </shape>
    <shape width="378" height="240" topLeftX="510" topLeftY="112" presetHandlers="0" type="rect" id="bPb">
      <fill>
        <fillColor color="rgba(240, 240, 240, 1)"/>
      </fill>
      <border color="rgba(3, 72, 149, 1)" width="1" lineJoin="miter" miterLimit="10"/>
      <content fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)"/>
    </shape>
    <shape width="354" height="224" topLeftX="522" topLeftY="120" type="text" id="bPk">
      <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 值传递：拿到的是副本 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">void</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> </span><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">badSwap</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(</span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> x, </span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> y) {</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> t = x; x = y; y = t; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 白换 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">}</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 指针传递：传地址，改原变量 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">void</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> </span><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">swap</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(</span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> *x, </span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> *y) {</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> t = *x; *x = *y; *y = t;</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">}</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">badSwap</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(a, b); </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* a=1 b=2 没换成功 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">swap</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(&amp;a, &amp;b); </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* a=2 b=1 换成了 */</span></p>
      </content>
    </shape>
