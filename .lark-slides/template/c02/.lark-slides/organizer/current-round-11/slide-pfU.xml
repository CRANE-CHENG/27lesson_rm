    <shape width="402" height="60" topLeftX="90.42" topLeftY="124" type="text" id="bPM">
      <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">函数 = 输入 + 处理 + 返回值</span></strong></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">名字要说明它干什么，Add 比 f1 有用得多。</span></p>
      </content>
    </shape>
