    <shape width="354" height="224" topLeftX="522" topLeftY="120" type="text" id="bPB">
      <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 定义：返回类型 函数名(参数表) */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> </span><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">Add</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(</span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> a, </span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> b) {</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">return</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> a + b; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 交给调用者 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">}</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"/>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 调用：传实参，接返回值 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> s = </span><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">Add</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(3, 5); </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* s = 8 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> t = </span><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">Add</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(s, 10); </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 结果还能再用 */</span></p>
      </content>
    </shape>
