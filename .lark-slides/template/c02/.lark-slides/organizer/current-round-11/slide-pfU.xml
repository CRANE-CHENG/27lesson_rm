      <content paddingTop="0" paddingBottom="0" paddingLeft="0" paddingRight="0" fontSize="12" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" bold="true" lineSpacing="multiple:1.2">
        <p textAlign="center"><strong><span color="rgba(255, 255, 255, 1)" fontSize="12" fontFamily="思源黑体">3.</span></strong></p>
