    <shape width="354" height="224" topLeftX="522" topLeftY="120" type="text" id="bGZ">
      <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 条件真假：0 为假，非 0 为真 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">if</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> (flag) { ... } /* flag != 0 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">if</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> (!flag) { ... } /* flag == 0 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"/>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* else if 梯：命中一个就跳出 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">if</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> (score &gt;= 90) grade = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">&apos;A&apos;</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">else if</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> (score &gt;= 60) grade = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">&apos;P&apos;</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">else</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> grade = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">&apos;F&apos;</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;</span></p>
      </content>
    </shape>
