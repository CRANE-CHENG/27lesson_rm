    <shape width="402" height="60" topLeftX="90.42" topLeftY="264" type="text" id="bGP">
      <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">一条语句也别省大括号</span></strong></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">省掉以后补一行，逻辑就悄悄变了，统一写上。</span></p>
      </content>
    </shape>
    <shape width="378" height="240" topLeftX="510" topLeftY="112" presetHandlers="0" type="rect" id="bGQ">
      <fill>
        <fillColor color="rgba(240, 240, 240, 1)"/>
      </fill>
      <border color="rgba(3, 72, 149, 1)" width="1" lineJoin="miter" miterLimit="10"/>
