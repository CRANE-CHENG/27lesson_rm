      <shape width="560" height="36.25" topLeftX="110.86724409448817" topLeftY="33.10251968503937" type="text" id="bMh">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="24" fontFamily="思源黑体" color="rgba(3, 72, 149, 1)" bold="true" italic="true" underline="false" strikethrough="false" lineSpacing="multiple:1.2" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><em><span color="rgba(3, 72, 149, 1)" fontSize="24" fontFamily="思源黑体" strikethrough="false" underline="false">一条直线写不出会判断、要重复的活</span></em></strong></p>
        </content>
      </shape>
      <shape width="20" height="20" topLeftX="62.42" topLeftY="128" presetHandlers="0" type="rect"><fill><fillColor color="rgba(3, 72, 149, 1)" /></fill><content paddingTop="0" paddingBottom="0" paddingLeft="0" paddingRight="0" fontSize="12" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" bold="true" lineSpacing="multiple:1.2" textAlign="center" verticalAlign="middle"><p textAlign="center"><span color="rgba(255, 255, 255, 1)" fontSize="12" fontFamily="思源黑体" bold="true">1.</span></p></content></shape><shape width="402" height="60" topLeftX="90.42" topLeftY="124" type="text" id="bMY">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">问题：重复的代码只能靠手抄</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">要让一个 LED 闪十次，按顺序写就得抄十遍。</span></p>
        </content>
      </shape>
      <shape width="20" height="20" topLeftX="62.42" topLeftY="198" presetHandlers="0" type="rect"><fill><fillColor color="rgba(3, 72, 149, 1)" /></fill><content paddingTop="0" paddingBottom="0" paddingLeft="0" paddingRight="0" fontSize="12" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" bold="true" lineSpacing="multiple:1.2" textAlign="center" verticalAlign="middle"><p textAlign="center"><span color="rgba(255, 255, 255, 1)" fontSize="12" fontFamily="思源黑体" bold="true">2.</span></p></content></shape><shape width="402" height="60" topLeftX="90.42" topLeftY="194" type="text" id="bMw">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">分支：条件不同，走不同的路</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">引脚读到低电平，才去消抖并把状态翻过来。</span></p>
        </content>
      </shape>
      <shape width="20" height="20" topLeftX="62.42" topLeftY="268" presetHandlers="0" type="rect"><fill><fillColor color="rgba(3, 72, 149, 1)" /></fill><content paddingTop="0" paddingBottom="0" paddingLeft="0" paddingRight="0" fontSize="12" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" bold="true" lineSpacing="multiple:1.2" textAlign="center" verticalAlign="middle"><p textAlign="center"><span color="rgba(255, 255, 255, 1)" fontSize="12" fontFamily="思源黑体" bold="true">3.</span></p></content></shape><shape width="402" height="60" topLeftX="90.42" topLeftY="264" type="text" id="bMz">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">循环：同一段代码重复执行</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">重复到条件不成立为止，闪灯、扫描、遍历都靠它。</span></p>
        </content>
      </shape>
      <shape width="378" height="230" topLeftX="510" topLeftY="112" presetHandlers="0" type="rect" id="bMI">
        <fill>
          <fillColor color="rgba(240, 240, 240, 1)" />
        </fill>
        <border color="rgba(3, 72, 149, 1)" width="1" lineJoin="miter" miterLimit="10" />
        <content fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" />
      </shape>
      <shape width="354" height="60" topLeftX="522" topLeftY="124" type="text" id="bMq">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 顺序：一条直线 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">a = 3; b = 4; c = a + b;</span></p>
        </content>
      </shape>
      <shape width="354" height="60" topLeftX="522" topLeftY="194" type="text" id="bMj">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 分支：满足条件才走 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">if</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> (a &gt; b) c = a;</span></p>
        </content>
      </shape>
      <shape width="354" height="60" topLeftX="522" topLeftY="264" type="text" id="bMV">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 循环：重复到条件不成立 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">for</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> (i = 0; i &lt; 3; i++) c = c + i;</span></p>
        </content>
      </shape>
      <shape width="817.58" height="32" topLeftX="62.42" topLeftY="372" presetHandlers="0" type="rect" id="bMN">
        <fill>
          <fillColor color="rgba(3, 72, 149, 1)" />
