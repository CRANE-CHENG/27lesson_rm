        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">char</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> name[16] = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">&quot;AIR&quot;</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 3 个字符 + 结尾 &apos;\0&apos; */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">strlen</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(name) -&gt; </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">3</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 数到 &apos;\0&apos; 为止 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">sizeof</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(name) -&gt; </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">16</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 数组多大就多大 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">char</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> *p = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">&quot;AIR&quot;</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 指针指向常量区，不能改 p[0] */</span></p>
