    <shape width="817.58" height="104" topLeftX="62.42" topLeftY="276" type="text" id="bvE">
      <content verticalAlign="top" paddingTop="1" paddingLeft="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> adc[8]; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 8 个 int，连续排在内存里 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">adc[0] = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">100</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 第 1 个：下标从 0 起 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">adc[7] = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">200</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 第 8 个：最后一个 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">adc[8] = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">300</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 越界！不报错，但改坏了别人的内存 */</span></p>
      </content>
    </shape>
