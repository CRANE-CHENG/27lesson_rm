      <shape width="354" height="224" topLeftX="522" topLeftY="120" type="text" id="bDD">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> g_cnt; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 全局：都能用 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35" />
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">void</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> </span><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">Count</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(</span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">void</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">) {</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">static</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> </span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> n = 0; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 只初始化一次 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">n++; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 退出也不销毁 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> tmp = n; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 局部：出函数就没了 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">printf</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(</span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">"n = %d\n"</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">, n);</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">}</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* tmp 出了函数就不能再用 */</span></p>
        </content>
      </shape>
