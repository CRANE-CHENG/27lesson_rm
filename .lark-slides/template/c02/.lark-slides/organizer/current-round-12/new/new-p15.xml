      <shape width="20" height="20" topLeftX="62.42" topLeftY="198.0" presetHandlers="0" type="rect"><fill><fillColor color="rgba(3, 72, 149, 1)" /></fill><content paddingTop="0" paddingBottom="0" paddingLeft="0" paddingRight="0" fontSize="12" fontFamily="思源黑体" color="rgba(255, 255, 255, 1)" bold="true" lineSpacing="multiple:1.2" textAlign="center" verticalAlign="middle"><p textAlign="center"><span color="rgba(255, 255, 255, 1)" fontSize="12" fontFamily="思源黑体" bold="true">2.</span></p></content></shape><shape width="402" height="60" topLeftX="90.42" topLeftY="194" type="text" id="bDe">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="20" fontFamily="思源黑体">全局变量哪里都能碰</span></strong></p>
