      <shape width="560" height="36.25" topLeftX="110.86724409448817" topLeftY="33.10251968503937" type="text" id="baz">
        <content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="24" fontFamily="思源黑体" color="rgba(3, 72, 149, 1)" bold="true" italic="true" underline="false" strikethrough="false" lineSpacing="multiple:1.2" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><em><span color="rgba(3, 72, 149, 1)" fontSize="24" fontFamily="思源黑体" strikethrough="false" underline="false">想让函数把结果带出来，就传地址</span></em></strong></p>
        </content>
      </shape>
      <shape width="430" height="60" topLeftX="62.42" topLeftY="124" type="text" id="baI">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="18" fontFamily="思源黑体">需求：一次换掉两个变量</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">return 只能带回一个值，两个都换就得靠指针写回去。</span></p>
        </content>
      </shape>
      <shape width="430" height="60" topLeftX="62.42" topLeftY="194" type="text" id="bah">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="18" fontFamily="思源黑体">值传递版本为什么白换</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">形参 x、y 是副本，函数里换的是副本，外面 a、b 没动。</span></p>
        </content>
      </shape>
      <shape width="430" height="60" topLeftX="62.42" topLeftY="264" type="text" id="bXF">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(3, 72, 149, 1)" fontSize="18" fontFamily="思源黑体">指针版本就三步</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">存一份副本、写过去、写回来，交换就完成了。</span></p>
        </content>
      </shape>
      <shape width="378" height="240" topLeftX="510" topLeftY="112" presetHandlers="0" type="rect" id="baV">
        <fill>
          <fillColor color="rgba(240, 240, 240, 1)" />
        </fill>
        <border color="rgba(3, 72, 149, 1)" width="1" lineJoin="miter" miterLimit="10" />
        <content fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" />
      </shape>
      <shape width="354" height="224" topLeftX="522" topLeftY="120" type="text" id="baN">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 指针版 swap：真的能换 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">void</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> </span><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">swap</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(</span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> *x, </span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> *y) {</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> t = *x; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 存一份 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">*x = *y; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 写过去 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">*y = t; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 写回来 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">}</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> a = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">1</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">, b = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">2</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(140, 70, 190, 1)" fontSize="16" fontFamily="Consolas">swap</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">(&amp;a, &amp;b); </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* a=2 b=1 */</span></p>
        </content>
      </shape>
      <shape width="817.58" height="32" topLeftX="62.42" topLeftY="372" presetHandlers="0" type="rect" id="baH">
        <fill>
          <fillColor color="rgba(3, 72, 149, 1)" />
