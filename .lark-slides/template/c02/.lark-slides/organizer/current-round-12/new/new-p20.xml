      <shape width="817.58" height="104" topLeftX="62.42" topLeftY="276" type="text" id="bQn">
        <content verticalAlign="top" paddingTop="1" paddingLeft="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> a = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">10</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">;</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> *p = &amp;a; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* p 里装的是 a 的地址 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">*p = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">20</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 解引用：改的就是 a 本身 */</span></p>
          <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> *q = arr; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 数组名 arr 就是首元素地址 */</span></p>
        </content>
      </shape>
