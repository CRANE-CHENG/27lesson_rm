      <shape width="752" height="48" topLeftX="128" topLeftY="212" type="text" id="bQe">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.3" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.3"><strong><span color="rgba(3, 72, 149, 1)" fontSize="18" fontFamily="思源黑体">指针的类型决定走多大一步</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.3"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">int * 走一步 4 字节，char * 走一步 1 字节；数组名就是首元素地址。</span></p>
        </content>
      </shape>
      <shape width="817.58" height="112" topLeftX="62.42" topLeftY="272" presetHandlers="0" type="rect" id="bQt">
