        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.3" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.3"><strong><span color="rgba(3, 72, 149, 1)" fontSize="18" fontFamily="思源黑体">&amp; 取地址，* 去取东西</span></strong></p>
          <p textAlign="left" lineSpacing="multiple:1.3"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="思源黑体">*p 的意思是「到 p 指的那个地址去」，可以读，也可以写。</span></p>
        </content>
      </shape>
      <shape width="4" height="40" topLeftX="56.42" topLeftY="212.0" presetHandlers="0" type="rect"><fill><fillColor color="rgba(3, 72, 149, 1)" /></fill><content /></shape><shape width="56" height="40" topLeftX="62.42" topLeftY="212" type="text" id="bQQ">
        <content verticalAlign="top" paddingTop="1" paddingBottom="1" paddingRight="1" fontSize="28" fontFamily="锐字真言体免费商用" color="rgba(3, 72, 149, 1)" bold="true" italic="true" underline="false" strikethrough="false" lineSpacing="multiple:1.2" textAlign="left" autoFit="shape-auto-fit">
          <p textAlign="left" lineSpacing="multiple:1.2"><strong><em><span color="rgba(3, 72, 149, 1)" fontSize="28" fontFamily="锐字真言体免费商用" strikethrough="false" underline="false">03</span></em></strong></p>
