    <shape width="817.58" height="104" topLeftX="62.42" topLeftY="276" type="text" id="bDE">
      <content verticalAlign="top" paddingTop="1" paddingLeft="1" paddingRight="1" fontSize="16" fontFamily="Consolas" color="rgba(31, 35, 41, 1)" lineSpacing="multiple:1.35" textAlign="left" autoFit="shape-auto-fit">
        <p textAlign="left" lineSpacing="multiple:1.35"><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">typedef struct</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> { </span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> y; </span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> m; </span><strong><span color="rgba(86, 156, 214, 1)" fontSize="16" fontFamily="Consolas">int</span></strong><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> d; } Date; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 定义新类型 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">Date d = { </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">2026</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">, </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">10</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">, </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">17</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas"> }; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 定义变量并初始化 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">d.m = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">12</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 用点取成员 */</span></p>
        <p textAlign="left" lineSpacing="multiple:1.35"><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">Date *p = &amp;d; p-&gt;y = </span><span color="rgba(4, 96, 199, 1)" fontSize="16" fontFamily="Consolas">2027</span><span color="rgba(31, 35, 41, 1)" fontSize="16" fontFamily="Consolas">; </span><span color="rgba(86, 86, 86, 1)" fontSize="16" fontFamily="Consolas">/* 指针用箭头取成员 */</span></p>
      </content>
    </shape>
