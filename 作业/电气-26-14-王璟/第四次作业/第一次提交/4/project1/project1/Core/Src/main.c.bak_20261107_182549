/* PB0 pressed (falling edge) -> turn blinking on/off.
   The LED is assumed to be active HIGH. If yours is active LOW,
   swap GPIO_PIN_SET and GPIO_PIN_RESET below. */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
  if (GPIO_Pin == KEY_Pin)
  {
    /* accept at most one press per KEY_DEBOUNCE_MS, kills contact bounce */
    if ((HAL_GetTick() - key_tick) >= KEY_DEBOUNCE_MS)
    {
      key_tick = HAL_GetTick();

      if (blink_en == 0U)
      {
        blink_en = 1U;
        led_on   = 1U;
        HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_SET);    /* light up at once */
        __HAL_TIM_SET_COUNTER(&htim1, 0U);                          /* restart the 5 s period */
      }
      else
      {
        blink_en = 0U;
        led_on   = 0U;
        HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_RESET);  /* switch off, stays off */
      }
    }
  }
}

/* TIM1 update: every 5 s, flip the LED while blinking is enabled */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
  if ((htim->Instance == TIM1) && (blink_en != 0U))
  {
    led_on ^= 1U;
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin,
                      (led_on != 0U) ? GPIO_PIN_SET : GPIO_PIN_RESET);
  }
}
